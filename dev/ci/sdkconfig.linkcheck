# CI link-coverage overlay. NOT a pin map and never flashed.
#
# With pins left at -1 (TBD) and no WiFi password, the compiler folds the
# hardware bring-up paths away, so a normal build would not prove they link.
# CI builds every node a second time with these placeholder values so all
# code (CAN, SD, LoRa, WiFi, BLE) is compiled AND linked with -Werror.
# Real pins come from each node's schematic (issue #15).
CONFIG_LBR_CAN_TX_GPIO=4
CONFIG_LBR_CAN_RX_GPIO=5
CONFIG_LBR_SD_SPI_MOSI_GPIO=23
CONFIG_LBR_SD_SPI_MISO_GPIO=19
CONFIG_LBR_SD_SPI_SCLK_GPIO=18
CONFIG_LBR_SD_SPI_CS_GPIO=15
CONFIG_LBR_LORA_SCLK_GPIO=14
CONFIG_LBR_LORA_MOSI_GPIO=13
CONFIG_LBR_LORA_MISO_GPIO=12
CONFIG_LBR_LORA_CS_GPIO=27
CONFIG_LBR_LORA_RST_GPIO=26
CONFIG_LBR_LORA_DIO0_GPIO=25
CONFIG_LBR_WIFI_PASSWORD="ci-link-check-only"
CONFIG_LBR_SENSOR_SIM=y
CONFIG_LBR_GPS_RX_GPIO=16
CONFIG_LBR_GPS_TX_GPIO=17
