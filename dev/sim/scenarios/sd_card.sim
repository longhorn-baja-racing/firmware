# The authoritative SD log on the Central: a pulled card is reported and a
# new session starts when it is back (the keeper retries every 5 s); write
# errors close the session and are counted, never silent. The car keeps
# running throughout.
at 3.0  expect central state == RUN
at 3.0  expect central overflow == 0
at 3.0  sd remove
at 4.0  expect central state == DEGRADED
at 4.0  expect central event:SD_WRITE_ERROR == 1
at 4.0  expect stress state == RUN
at 4.0  expect dashboard link == 1
at 6.0  sd insert
at 7.0  expect central state == DEGRADED
at 9.0  expect central state == RUN
at 9.0  expect central event:SD_MOUNTED >= 1
at 9.0  expect log intact == 1
at 9.0  expect log frames > 1000

at 10.0 sd fail 3
at 11.0 expect central state == DEGRADED
at 11.0 expect central event:SD_WRITE_ERROR == 2
at 16.0 expect central state == RUN
at 16.0 expect log intact == 1
at 16.0 expect all state == RUN
end 16.0
