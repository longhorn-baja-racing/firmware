menu "LBR corner node"

    choice LBR_CORNER_POSITION_CHOICE
        prompt "Position on the car"
        default LBR_CORNER_FL
        help
            The same firmware runs on all four wheel hub nodes; this picks
            the CAN node id (7..10) and the IMU frames it sends.

        config LBR_CORNER_FL
            bool "FL (front left)"
        config LBR_CORNER_FR
            bool "FR (front right)"
        config LBR_CORNER_BL
            bool "BL (back left)"
        config LBR_CORNER_BR
            bool "BR (back right)"
    endchoice

    config LBR_CORNER_POSITION
        int
        default 0 if LBR_CORNER_FL
        default 1 if LBR_CORNER_FR
        default 2 if LBR_CORNER_BL
        default 3 if LBR_CORNER_BR

endmenu
