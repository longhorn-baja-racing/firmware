# Gateway node. Shared settings: car/nodes/sdkconfig.common. Generated sdkconfig is gitignored.

# Two OTA slots for WiFi updates, with rollback if a new image never
# confirms itself healthy.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# BLE walk-up diagnostics (NimBLE, peripheral only) alongside WiFi.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# WiFi + BLE + CAN + SD + LoRa overflow ESP32 IRAM with the WiFi speed-ups
# resident. Move them to flash: the pit link needs far less than peak WiFi
# throughput. The TWAI ISR stays in IRAM (CONFIG_TWAI_ISR_CACHE_SAFE in
# sdkconfig.common) so CAN reception is unaffected.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_WIFI_EXTRA_IRAM_OPT=n

# Authoritative log: room to ride out SD stalls at full bus rate.
CONFIG_LBR_LOG_QUEUE_KB=64

CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_HTTPD_MAX_URI_LEN=64
