# Pins and calibration of the slots read by on-chip inputs (input = "io").

menu "LBR stress inputs"

    config LBR_IO_STRESS
        string "Slot 'stress' input spec"
        default ""
        help
            Channels, in order: STRESS_1, STRESS_2, STRESS_3, STRESS_4,
            STRESS_5, STRESS_6, STRESS_7, STRESS_8 (frames 0x400 and 0x401).
            Typically a bridge amplifier/ADC part driver instead (the
            on-chip ADC is too noisy).
            Empty = not fitted (or simulated with LBR_SENSOR_SIM). Otherwise one
            ';'-separated entry per channel using the on-chip inputs: '-',
            'adc ...', 'pulse ...', or 'din ...'. Syntax and examples are in
            lbrlib/docs/drivers.md and docs/sensors.md. The spec is the
            calibration and is recorded in every session.

endmenu
