menu "LBR temperature inputs"

    config LBR_IO_DRIVETRAIN
        string "Slot 'drivetrain' input spec"
        default ""
        help
            Channels, in order: TEMP_ENGINE, TEMP_CVT, TEMP_GEARBOX.
            Empty = not fitted (or simulated with LBR_SENSOR_SIM). Otherwise one
            ';'-separated entry per channel using the on-chip inputs: '-',
            'adc ...', 'pulse ...', or 'din ...'. Syntax and examples are in
            car/components/sensors/include/lbr/sensor_io.h and docs/sensors.md.
            The spec is the calibration and is recorded in every session.

    config LBR_IO_BRAKES
        string "Slot 'brakes' input spec"
        default ""
        help
            Channels, in order: TEMP_BRAKE_FRONT, TEMP_BRAKE_REAR.
            Empty = not fitted (or simulated with LBR_SENSOR_SIM). Otherwise one
            ';'-separated entry per channel using the on-chip inputs: '-',
            'adc ...', 'pulse ...', or 'din ...'. Syntax and examples are in
            car/components/sensors/include/lbr/sensor_io.h and docs/sensors.md.
            The spec is the calibration and is recorded in every session.

    config LBR_IO_AMBIENT
        string "Slot 'ambient' input spec"
        default ""
        help
            Channels, in order: TEMP_AMBIENT.
            Empty = not fitted (or simulated with LBR_SENSOR_SIM). Otherwise one
            ';'-separated entry per channel using the on-chip inputs: '-',
            'adc ...', 'pulse ...', or 'din ...'. Syntax and examples are in
            car/components/sensors/include/lbr/sensor_io.h and docs/sensors.md.
            The spec is the calibration and is recorded in every session.

    config LBR_IO_AUX
        string "Slot 'aux' input spec"
        default ""
        help
            Channels, in order: TEMP_AUX_1, TEMP_AUX_2, TEMP_AUX_3, TEMP_AUX_4.
            Empty = not fitted (or simulated with LBR_SENSOR_SIM). Otherwise one
            ';'-separated entry per channel using the on-chip inputs: '-',
            'adc ...', 'pulse ...', or 'din ...'. Syntax and examples are in
            car/components/sensors/include/lbr/sensor_io.h and docs/sensors.md.
            The spec is the calibration and is recorded in every session.

endmenu
